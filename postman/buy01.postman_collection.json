  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName || '';",
          "const expected = requestName.match(/-> (\\d{3})$/);",
          "",
          "if (expected) {",
          "  pm.test(`Status ${expected[1]}`, function () {",
          "    pm.response.to.have.status(Number(expected[1]));",
          "  });",
          "}",
          "",
          "if (pm.response.code === 201) {",
          "  const body = pm.response.json();",
          "",
          "  if (requestName.startsWith('Create product')) {",
          "    pm.collectionVariables.set('product_id', body.id);",
          "  }",
          "",
          "  if (requestName.startsWith('Upload product image')) {",
          "    pm.collectionVariables.set('image_id', body.id);",
          "  }",
          "",
          "  if (requestName.startsWith('Upload avatar')) {",
          "    pm.collectionVariables.set('avatar_id', body.id);",
          "  }",
          "}"
        ]
      }
    }
  ],
